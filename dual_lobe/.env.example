# ---- Postgres (canonical source of truth) ----
POSTGRES_USER=dual_lobe
POSTGRES_PASSWORD=dual_lobe_dev
POSTGRES_DB=dual_lobe
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dual_lobe:dual_lobe_dev@localhost:5432/dual_lobe
# Tenant-scoped (RLS) connection used by the request data plane. Role dual_lobe_rls
# is created by the alembic migration. Leave unset to share the admin connection.
RLS_DATABASE_URL=postgresql+asyncpg://dual_lobe_rls:dual_lobe_rls@localhost:5432/dual_lobe

# ---- Redis / valkey (rate limits + optional state cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Gateway listen ----
DUAL_LOBE_HOST=0.0.0.0
DUAL_LOBE_PORT=8801

# ---- Gateway API keys (scoped, one per entry: key|scope1,scope2|tenant-slug) ----
# Replace with real secret values. Used by the bootstrap command to seed api_keys.
DUAL_LOBE_BOOTSTRAP_KEYS=
DUAL_LOBE_SEED_TENANT_SLUG=default
DUAL_LOBE_SEED_TENANT_NAME=Default Tenant

# ---- Upstream provider connections (Lobe A / Lobe B) ----
# Lobe A defaults to the CrewAI worker model upstream (Featherless).
DUAL_LOBE_A_MODEL=zai-org/GLM-5.3-Flash
DUAL_LOBE_A_BASE_URL=https://api.featherless.ai/v1
DUAL_LOBE_A_API_KEY=
DUAL_LOBE_A_DIALECT=chat_completions
DUAL_LOBE_B_MODEL=zai-org/GLM-5.3-Flash
DUAL_LOBE_B_BASE_URL=https://api.featherless.ai/v1
DUAL_LOBE_B_API_KEY=
DUAL_LOBE_B_DIALECT=chat_completions

# ---- Optional search evidence source (Lobe-B pre-pass; fail-open when unset) ----
FIRECRAWL_API_KEY=

# ---- Lobe B behaviour ----
# FAST_BOOTSTRAP = B runs fully off A's critical path; A call #2 sees first rich state.
# ENRICHED_BOOTSTRAP = opt-in for earlier enrichment at the cost of A latency.
DUAL_LOBE_BOOTSTRAP=FAST_BOOTSTRAP
# Staged rollout mode. Each stage adds behaviour:
#   observation        -> A only; B records evidence, no injection
#   context            -> B distilled context is injected into later A calls
#   integrity-observe  -> B challenges recorded, surfaced as warnings only
#   integrity-intervene-> HIGH/CRITICAL challenges become verification preconditions
#   enforcement        -> CRITICAL findings block propagation of false completion
DUAL_LOBE_ROLLOUT_STAGE=observation
# Max B model calls per minute and max cumulative B spend units per hour per tenant.
DUAL_LOBE_B_RPM_LIMIT=20
DUAL_LOBE_B_SPEND_UNITS_PER_HOUR=200
DUAL_LOBE_B_FAIL_OPEN=true
# Pulse: run a Context Shadow pre+post cycle on the first call of a (run,floor,attempt),
# then every N calls within that context.
DUAL_LOBE_PULSE_EVERY=3
DUAL_LOBE_MAX_INJECTION_CHARS=7000
DUAL_LOBE_MAX_SHADOW_INPUT_CHARS=30000

# ---- Rate limits (per tenant) ----
DUAL_LOBE_RPM_LIMIT=600
DUAL_LOBE_TPM_LIMIT=120000

# ---- Observability ----
DUAL_LOBE_OTEL_ENABLED=false
DUAL_LOBE_LOG_LEVEL=INFO